# Meta MCP Server Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="Meta MCP Server"
APP_VERSION="2.0.0"
DEBUG=true
ENVIRONMENT=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (Development)
DATABASE_URL=sqlite+aiosqlite:///./meta_mcp.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/meta_mcp

DATABASE_ECHO=false

# =============================================================================
# REDIS CONFIGURATION (Optional - for caching and pub/sub)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# MCP PROTOCOL SETTINGS
# =============================================================================
MCP_PROTOCOL_VERSION=2024-11-05
MCP_CONNECTION_TIMEOUT=30
MCP_HEALTH_CHECK_INTERVAL=60
MCP_MAX_RETRIES=3
MCP_RETRY_DELAY=5

# =============================================================================
# TRANSPORT CONFIGURATION
# =============================================================================
DEFAULT_TRANSPORT=stdio
SSE_PORT=3001
HTTP_PORT=3002
WEBSOCKET_PORT=3003

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY=your-super-secret-key-change-this-in-production
API_KEY_HEADER=X-API-Key

# =============================================================================
# EXTERNAL API KEYS (for MCP servers)
# =============================================================================

# GitHub Personal Access Token
# Required for GitHub MCP server
# Get from: https://github.com/settings/tokens

# Slack Bot Token  
# Required for Slack MCP server
# Get from: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_TEAM_ID=T1234567890

# OpenWeather API Key
# Required for enhanced weather features
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=0ff1ad734dcf96850f487ee0b92eda44

# Brave Search API Key
# Required for Brave search MCP server
# Get from: https://brave.com/search/api/
BRAVE_API_KEY=BSAl3cQcXN4GrDcHgKg0OEwvO0ZSOwa

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
MAX_CONCURRENT_CONNECTIONS=100
CONNECTION_POOL_SIZE=20
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10485760

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=meta_mcp.log

# =============================================================================
# FEATURE FLAGS
# =============================================================================
AUTO_REGISTER_EXAMPLES=true
ENABLE_SERVER_TEMPLATES=true
ENABLE_SMART_ROUTING=true
HEALTH_CHECK_ENABLED=true

# =============================================================================
# ROUTING CONFIGURATION
# =============================================================================
ROUTING_CONFIDENCE_THRESHOLD=0.3
MAX_ROUTING_SUGGESTIONS=5

# =============================================================================
# HEALTH CHECK SETTINGS
# =============================================================================
HEALTH_CHECK_TIMEOUT=10
MAX_HEALTH_CHECK_FAILURES=3

# =============================================================================
# FASTMCP SETTINGS
# =============================================================================
FASTMCP_SERVER_NAME="Meta MCP Server"
FASTMCP_STDIO_BUFFER_SIZE=65536

# =============================================================================
# DispatchMCP SETTINGS
# =============================================================================
PSA_SERVICE_URL=http://localhost:9019
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL=300